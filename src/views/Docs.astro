---
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StepCard from '../components/StepCard.astro';
import { getI18n } from '../i18n/context';
import Layout from '../layouts/Layout.astro';

const { t } = getI18n(Astro.currentLocale);
const skills = [
  { step: 'docs.skill1Label', title: 'docs.skill1Title', description: 'docs.skill1Description' },
  { step: 'docs.skill2Label', title: 'docs.skill2Title', description: 'docs.skill2Description' },
  { step: 'docs.skill3Label', title: 'docs.skill3Title', description: 'docs.skill3Description' },
  { step: 'docs.skill4Label', title: 'docs.skill4Title', description: 'docs.skill4Description' },
] as const;
---

<Layout title={t('nav.docs')} description={t('docs.metaDescription')}>
  <Section last>
    <SectionHeader eyebrow={t('docs.eyebrow')} title={t('docs.title')} level={1} description={t('docs.description')} />
    <ol class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {skills.map(skill => (
        <StepCard step={t(skill.step)} title={t(skill.title)}>
          {t(skill.description)}
        </StepCard>
      ))}
    </ol>
  </Section>
</Layout>
